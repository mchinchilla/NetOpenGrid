<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Label="NuGet package metadata">
    <IsPackable>true</IsPackable>
    <Authors>Marvin Chinchilla</Authors>
    <Company>NetOpenGrid</Company>
    <Product>NetOpenGrid</Product>
    <Copyright>Copyright (c) 2026 Marvin Chinchilla</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/mchinchilla/NetOpenGrid</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mchinchilla/NetOpenGrid</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>grid;datagrid;table;aspnetcore;htmx;alpinejs;tailwind;server-side-rendering;ssr;dotnet;net10</PackageTags>
    <!-- nuget.org strips raw HTML (the centered header divs) and does not render Mermaid, so the packages
         ship docs/nuget-readme.md (plain Markdown, absolute URLs) instead of the GitHub README. -->
    <PackageReadmeFile>nuget-readme.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Label="Symbols, Source Link and docs">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: public members without XML doc comments. Docs are encouraged but not mandatory. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)../docs/nuget-readme.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
