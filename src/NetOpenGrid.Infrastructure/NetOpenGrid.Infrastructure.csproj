<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>NetOpenGrid: server-rendered HTML data grid for ASP.NET Core (.NET 10) powered by HTMX + Alpine.js. Precompiled delegates (no reflection on the hot path), Excel-style filters with value counts, pinned and reorderable columns, nested grouping, server-side CSV export, i18n and embedded assets. Start here: AddNetOpenGrid() + MapNetOpenGrid().</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NetOpenGrid.Integration.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\**" Exclude="Assets\css\**;Assets\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NetOpenGrid.Application/NetOpenGrid.Application.csproj" />
  </ItemGroup>
  <Target Name="CompileTailwindThemes" BeforeTargets="BeforeBuild">
    <Exec Condition="'$(OS)' == 'Windows_NT'" Command="tools\build-themes.cmd" WorkingDirectory="$(MSBuildThisFileDirectory)../.." />
    <Exec Condition="'$(OS)' != 'Windows_NT'" Command="./tools/build-themes.sh" WorkingDirectory="$(MSBuildThisFileDirectory)../.." />
    <ItemGroup>
      <EmbeddedResource Include="Assets\css\*.css" />
    </ItemGroup>
  </Target>
</Project>
