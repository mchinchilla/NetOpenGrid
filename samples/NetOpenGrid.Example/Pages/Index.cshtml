@page
@{
    ViewData["Title"] = "Products";
    ViewData["Nav"] = "products";
}

<section class="page-head">
    <h1>Product catalog</h1>
    <p>
        Typed in-memory grid. Try the Excel-style filter on <em>Category</em>, shift-click two headers
        for a multi-sort, drag a header to reorder, pick rows to export them, or open a product by
        clicking its row. <em>Archive</em> is an event action handled by this page.
    </p>
</section>

<div class="grid-card">
    @* ?embed=1 drops the standalone chrome (site header, page background, padding). *@
    <iframe class="grid-frame" data-netgrid src="/netgrid/products?embed=1" title="Product catalog"></iframe>
</div>

<div class="toast" role="status" aria-live="polite" hidden></div>

@* Row actions of kind Event reach the host page as a same-origin postMessage (the grid is in an iframe).
   A real app would call its API here, then ask the grid for fresh rows. *@
<script>
    const toast = document.querySelector(".toast");
    // Bulk actions arrive the same way, with the keys of the selected rows. The host confirms, calls
    // its own API (a timer stands in for it here), and then tells the grid it is done.
    window.addEventListener("message", (e) => {
        if (e.origin !== location.origin || e.data?.type !== "netgrid:bulk-action") return;
        const { grid, action, keys, count } = e.data;
        if (!confirm(`${action}: ${count} product(s)?`)) return;

        const frame = document.querySelector("iframe[data-netgrid]");
        const send = (type, extra) => frame.contentWindow.postMessage({ type, grid, ...extra }, location.origin);
        send("netgrid:busy", { busy: true });
        setTimeout(() => {
            toast.textContent = `${action}: ${keys.join(", ")} (demo: nothing was changed)`;
            toast.hidden = false;
            clearTimeout(toast.timer);
            toast.timer = setTimeout(() => { toast.hidden = true; }, 3000);
            send("netgrid:busy", { busy: false });
            send("netgrid:clear-selection");
            send("netgrid:refresh");
        }, 800);
    });

    window.addEventListener("message", (e) => {
        if (e.origin !== location.origin || e.data?.type !== "netgrid:action") return;
        toast.textContent = `${e.data.action} ${e.data.key} (demo: nothing was changed)`;
        toast.hidden = false;
        clearTimeout(toast.timer);
        toast.timer = setTimeout(() => { toast.hidden = true; }, 3000);

        const frame = document.querySelector("iframe[data-netgrid]");
        frame.contentWindow.postMessage({ type: "netgrid:refresh", grid: e.data.grid }, location.origin);
    });
</script>
