root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{cs}]
csharp_style_namespace_declarations = file_scoped:error
csharp_style_prefer_primary_constructors = false
dotnet_style_readonly_field = true

[*.{json,yml,yaml,css,js,xml}]
indent_size = 2
